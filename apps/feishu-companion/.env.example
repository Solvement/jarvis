# 仅本机个人使用；模型使用 codex login 的 ChatGPT 登录态。
PORT=4399
# 有多个 Codex 安装时，填写 codex.exe 或 @openai/codex/bin/codex.js 的绝对路径。
CODEX_BIN=
# 留空使用当前 Codex 配置的默认模型。
CODEX_MODEL=
# 飞书自建应用：机器人、长连接事件 im.message.receive_v1。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 可留空，在本机页面获取一次性 /pair 命令后由本人私聊机器人完成绑定。
FEISHU_OWNER_OPEN_ID=
# 本人聊天尚未显式绑定文档时，默认讨论这篇；/doc clear 可取消。
FEISHU_DEFAULT_DOCUMENT=

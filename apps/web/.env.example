# 生产：Neon Postgres 连接串（Vercel 集成自动注入）。本地不填则使用 PGlite（.pglite/ 目录）。
DATABASE_URL=
# 作者导入凭证（Bearer）。只存在作者本机与服务器 secret。
AUTHOR_TOKEN=
# Vercel Cron 调用 /api/cron/refresh 时携带的凭证。
CRON_SECRET=
# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 能看到草稿的作者邮箱，逗号分隔。
OWNER_EMAILS=

# 生产：Neon Postgres 连接串（Vercel 集成自动注入）。本地不填则使用 PGlite（.pglite/ 目录）。
DATABASE_URL=
# 作者导入凭证（Bearer）。只存在作者本机与服务器 secret。
AUTHOR_TOKEN=
# Vercel Cron 调用 /api/cron/refresh 时携带的凭证。
CRON_SECRET=
# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 额外允许的站点 Origin，逗号分隔；不要使用通配符。保留原 GitHub 回调域名。
AUTH_TRUSTED_ORIGINS=
# Resend Marketplace 自动注入。只用于服务端验证码，不发送营销邮件。
RESEND_API_KEY=
RESEND_EMAIL_DOMAIN=
# 能看到草稿的作者邮箱，逗号分隔。
OWNER_EMAILS=

# 仅开发、仅回环地址、无远端数据库和 OAuth 时启用本机私人书架。
PERSONAL_LOCAL_MODE=0
# 模型密钥仅保存在服务器环境；复用本机已有环境变量即可。
CHAT_PROVIDER=deepseek
CHAT_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
